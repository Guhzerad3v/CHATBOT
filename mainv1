import os
import PyPDF2
from langchain_core.prompts import PromptTemplate
from langchain_groq import ChatGroq
# ==========================================
# 1. Configuração da API
# ==========================================
# Inserindo a chave de acesso do Groq via variável de ambiente
os.environ["GROQ_API_KEY"] = "your_key"
# ==========================================
# 2. Extração de Conteúdo (Leitura do PDF)
# ==========================================
nome_do_arquivo = "Alan_Turing.pdf" # Substitua pelo nome do seu arquivo PDF
contexto_pdf = ""
print(f"Iniciando a leitura do arquivo '{nome_do_arquivo}'...")
try:
# Abrindo o arquivo em modo leitura binária ('rb')
with open(nome_do_arquivo, "rb") as arquivo_pdf:
leitor = PyPDF2.PdfReader(arquivo_pdf)
# Percorrendo todas as páginas e extraindo o texto
for pagina in leitor.pages:
texto_extraido = pagina.extract_text()
if texto_extraido:
contexto_pdf += texto_extraido + "\n"
print("Leitura concluída com sucesso! O contexto foi carregado.\n")
except FileNotFoundError:
print(f"Erro: O arquivo '{nome_do_arquivo}' não foi encontrado.")
print("Por favor, coloque um arquivo PDF no mesmo diretório do script e tente novamente.")
exit()
# ==========================================
# 3. Criação do Prompt Dinâmico
# ==========================================
# O template instrui a IA a usar APENAS o contexto fornecido
template_instrucao = """Você é um assistente especialista na análise de documentos.
Abaixo está o conteúdo extraído de um arquivo PDF. Você deve usar ÚNICA E EXCLUSIVAMENTE este contexto para responder à pergunta do usuário.
Se a resposta não estiver no contexto fornecido, diga educadamente que o documento não contém essa informação. Não invente dados.
Contexto do Documento:
{contexto_pdf}
Pergunta do Usuário:
{pergunta}
Sua Resposta:"""
# Configurando o template no formato do LangChain
prompt = PromptTemplate(
input_variables=["contexto_pdf", "pergunta"],
template=template_instrucao
)
# ==========================================
# 4. Configuração do Modelo Groq
# ==========================================
# Inicializando o modelo exigido com a biblioteca langchain_groq
modelo_llm = ChatGroq(model_name="llama-3.3-70b-versatile")
# Criando a 'Chain' (Cadeia) conectando o prompt ao modelo de linguagem
cadeia_de_processamento = prompt | modelo_llm
# ==========================================
# 5. Loop de Conversa
# ==========================================
print("-" * 50)
print("Chatbot de Análise de PDF Iniciado.")
print("Faça sua pergunta sobre o documento ou digite 'x' para sair.")
print("-" * 50)
while True:
# Recebe a entrada do usuário

pergunta_usuario = input("\nVocê: ")
# Condição de encerramento
if pergunta_usuario.strip().lower() == 'x':
print("\nMuito obrigado por utilizar o nosso sistema. Até a próxima!")
break
# Evita processamento de strings vazias
if not pergunta_usuario.strip():
continue
print("Processando resposta...")
try:
# Invoca a cadeia passando as variáveis esperadas pelo prompt
resposta_ia = cadeia_de_processamento.invoke({
"contexto_pdf": contexto_pdf,
"pergunta": pergunta_usuario
})
# Exibe o conteúdo gerado pela IA
print(f"\nIA: {resposta_ia.content}")
except Exception as erro:
print(f"\nOcorreu um erro durante a comunicação com a API: {erro}")
from google.colab import files
