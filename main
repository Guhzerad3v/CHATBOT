 https://colab.research.google.com/drive/1Qaj2gxUClduX_ftQN_-buGIZtBGkemF5
"""
import os
import PyPDF2
from langchain_core.prompts import PromptTemplate
from langchain_groq import ChatGroq
# ==========================================
# 1. Configuração da API
# ==========================================
os.environ["GROQ_API_KEY"] = "your_key"
# ==========================================
# 2. Extração de Conteúdo (Leitura do PDF)
# ==========================================
nome_do_arquivo = "Alan_Turing.pdf"
contexto_pdf = ""
try:
with open(nome_do_arquivo, "rb") as arquivo_pdf:
leitor = PyPDF2.PdfReader(arquivo_pdf)
for pagina in leitor.pages:
texto_extraido = pagina.extract_text()
if texto_extraido:
contexto_pdf += texto_extraido + "\n"
# CORREÇÃO: Limita o contexto para não estourar os tokens da API (erro 413)
if len(contexto_pdf) > 10000:
print("O PDF é muito grande. Usando apenas os primeiros 10.000 caracteres para evitar erro na API.")
contexto_pdf = contexto_pdf[:10000]
print("Leitura concluída com sucesso!\n")
except FileNotFoundError:
print(f"Erro: O arquivo '{nome_do_arquivo}' não foi encontrado.")
# ==========================================
# 3. Criação do Prompt Dinâmico
# ==========================================
template_instrucao = """Você é um assistente especialista na análise de documentos.
Use APENAS o contexto abaixo para responder. Seja conciso.
Contexto:
{contexto_pdf}
Pergunta:
{pergunta}
Resposta:"""
prompt = PromptTemplate(
input_variables=["contexto_pdf", "pergunta"],
template=template_instrucao
)
# ==========================================
# 4. Configuração do Modelo Groq
# ==========================================
modelo_llm = ChatGroq(model_name="llama-3.3-70b-versatile")
cadeia_de_processamento = prompt | modelo_llm
# ==========================================
# 5. Loop de Conversa
# ==========================================
print("Chatbot pronto. Digite 'x' para sair.")
while True:
pergunta_usuario = input("\nVocê: ")
if pergunta_usuario.strip().lower() == 'x': break
if not pergunta_usuario.strip(): continue
print("Processando...")
try:
resposta_ia = cadeia_de_processamento.invoke({
"contexto_pdf": contexto_pdf,
"pergunta": pergunta_usuario
})
print(f"\nIA: {resposta_ia.content}")
except Exception as erro:
print(f"\nOcorreu um erro: {erro}")
